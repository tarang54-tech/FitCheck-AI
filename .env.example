# FitCheck AI Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file with secrets into version control.

# Flask Application Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=your-random-32-byte-secret-key-here

# MongoDB Atlas
# Full connection string for your MongoDB Atlas cluster:
# e.g. mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Groq Cloud API
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI in Google Cloud Console must be set to:
# Local dev: http://localhost:5000/login/callback (or http://127.0.0.1:5000/login/callback)
# Production: https://<your-render-service-name>.onrender.com/login/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# MediaPipe Pose Model Path (Optional, defaults to pose_landmarker_heavy.task)
POSE_MODEL_PATH=pose_landmarker_heavy.task
